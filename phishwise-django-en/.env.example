# Create a private .env file beside manage.py and paste your own key.
VIRUSTOTAL_API_KEY=

# Unknown file uploads may be shared with VirusTotal partners/researchers.
# Enable this only for public download links that you are allowed to submit.
VIRUSTOTAL_UPLOAD_UNKNOWN_FILES=false
VIRUSTOTAL_POLL_ATTEMPTS=3
VIRUSTOTAL_POLL_SECONDS=2

# Windows only: folder containing Pango/GTK DLLs used by WeasyPrint.
# The default C:\msys64\mingw64\bin is detected automatically.
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
